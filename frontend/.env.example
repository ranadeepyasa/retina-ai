# RetinaAI Frontend Environment Configuration
# For local development connecting directly to FastAPI:
VITE_API_BASE_URL=http://localhost:8000/api

# For local development with Vite dev proxy (alternative):
# VITE_API_BASE_URL=/api

# For production deployment on Vercel:
# Set VITE_API_BASE_URL in Vercel Project Settings > Environment Variables
# VITE_API_BASE_URL=https://your-backend-domain.com/api

