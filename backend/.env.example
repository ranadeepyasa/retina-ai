# RetinaAI - Environment Configuration
APP_NAME="RetinaAI - Explainable DR Screening"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security (Must be replaced with a strong cryptographically random secret in production)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_with_secure_random_secret
JWT_SECRET_KEY=replace_with_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for production or SQLite for local dev)
# For Postgres: DATABASE_URL=postgresql://username:password@localhost:5432/retina_ai
# For SQLite (default): DATABASE_URL=sqlite:///./retina_ai.db
DATABASE_URL=postgresql://username:password@localhost:5432/retina_ai

# Storage
UPLOAD_DIR="./uploads"
MODELS_DIR="./models"

# AI Model Configuration
MODEL_PATH="./models/dr_model.pth"
METRICS_PATH="./models/metrics.json"
DEMO_MODE=true

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
