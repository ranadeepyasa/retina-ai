# RetinaAI - Environment Configuration
APP_NAME="RetinaAI - Explainable DR Screening"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security (Must be replaced with a strong cryptographically random secret in production)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-minimum-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL or SQLite fallback)
# For Postgres: postgresql://postgres:postgres@localhost:5432/retina_ai
DATABASE_URL="sqlite:///./retina_ai.db"

# Storage
UPLOAD_DIR="./uploads"
MODELS_DIR="./models"

# AI Model Configuration
MODEL_PATH="./models/dr_model.pth"
METRICS_PATH="./models/metrics.json"
DEMO_MODE=true

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
